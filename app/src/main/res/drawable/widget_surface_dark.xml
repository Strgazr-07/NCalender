<?xml version="1.0" encoding="utf-8"?>
<!--
  Live background for the Upcoming widget's container, in explicit dark/light pairs rather
  than a -night qualifier: the widget follows the APP's theme setting, which can be forced
  LIGHT on a dark system (or vice versa), and a qualifier would resolve against the system
  instead. UpcomingWidget picks between these via setInt(..., "setBackgroundResource", ...).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#0A0A09" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#2A2A28" />
</shape>
