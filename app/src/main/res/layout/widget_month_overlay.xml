<?xml version="1.0" encoding="utf-8"?>
<!--
  Transparent tap targets laid over the calendar bitmap — one per day cell. The calendar
  itself is a single bitmap (WidgetRenderer.renderMonthCalendar), which is what lets the day
  numbers be sized against a known column width instead of each cell guessing the space a
  GridView will hand it. These empty ImageViews carry only the click, no drawable, so the
  whole overlay costs nothing to transmit.

  The weights here MUST match GRID_TOP_FRACTION in WidgetRenderer: the spacer covers the
  month/weekday header (28%) and the six week rows split the remaining 72%.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
