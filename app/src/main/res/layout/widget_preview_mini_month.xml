<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="JULY"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.06"
            android:fontFamily="@font/ndot55_regular" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026"
            android:textColor="#8A8A88"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="@font/ntype82_mono" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView style="@style/WidgetPreviewDow" android:text="S" />
        <TextView style="@style/WidgetPreviewDow" android:text="M" />
        <TextView style="@style/WidgetPreviewDow" android:text="T" />
        <TextView style="@style/WidgetPreviewDow" android:text="W" />
        <TextView style="@style/WidgetPreviewDow" android:text="T" />
        <TextView style="@style/WidgetPreviewDow" android:text="F" />
        <TextView style="@style/WidgetPreviewDow" android:text="S" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView style="@style/WidgetPreviewDay" android:text="" />
        <TextView style="@style/WidgetPreviewDay" android:text="" />
        <TextView style="@style/WidgetPreviewDay" android:text="" />
        <TextView style="@style/WidgetPreviewDay" android:text="1" />
        <TextView style="@style/WidgetPreviewDay" android:text="2" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/widget_preview_today"
                android:text="3"
                android:textColor="#000000"
                android:textSize="11sp"
                android:fontFamily="@font/ndot55_regular" />
        </FrameLayout>
        <TextView style="@style/WidgetPreviewDay" android:text="4" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView style="@style/WidgetPreviewDay" android:text="5" />
        <TextView style="@style/WidgetPreviewDay" android:text="6" />
        <TextView style="@style/WidgetPreviewDay" android:text="7" />
        <TextView style="@style/WidgetPreviewDay" android:text="8" />
        <TextView style="@style/WidgetPreviewDay" android:text="9" />
        <TextView style="@style/WidgetPreviewDay" android:text="10" />
        <TextView style="@style/WidgetPreviewDay" android:text="11" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView style="@style/WidgetPreviewDay" android:text="12" />
        <TextView style="@style/WidgetPreviewDay" android:text="13" />
        <TextView style="@style/WidgetPreviewDay" android:text="14" />
        <TextView style="@style/WidgetPreviewDay" android:text="15" />
        <TextView style="@style/WidgetPreviewDay" android:text="16" />
        <TextView style="@style/WidgetPreviewDay" android:text="17" />
        <TextView style="@style/WidgetPreviewDay" android:text="18" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView style="@style/WidgetPreviewDay" android:text="19" />
        <TextView style="@style/WidgetPreviewDay" android:text="20" />
        <TextView style="@style/WidgetPreviewDay" android:text="21" />
        <TextView style="@style/WidgetPreviewDay" android:text="22" />
        <TextView style="@style/WidgetPreviewDay" android:text="23" />
        <TextView style="@style/WidgetPreviewDay" android:text="24" />
        <TextView style="@style/WidgetPreviewDay" android:text="25" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView style="@style/WidgetPreviewDay" android:text="26" />
        <TextView style="@style/WidgetPreviewDay" android:text="27" />
        <TextView style="@style/WidgetPreviewDay" android:text="28" />
        <TextView style="@style/WidgetPreviewDay" android:text="29" />
        <TextView style="@style/WidgetPreviewDay" android:text="30" />
        <TextView style="@style/WidgetPreviewDay" android:text="31" />
        <TextView style="@style/WidgetPreviewDay" android:text="" />
    </LinearLayout>
</LinearLayout>
