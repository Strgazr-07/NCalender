<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/widget_preview_dot"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="NEXT EVENT"
            android:textColor="#8A8A88"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:fontFamily="@font/ntype82_mono" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="in 25m"
            android:textColor="#D71921"
            android:textSize="12sp"
            android:fontFamily="@font/ndot55_regular" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="3dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_preview_bar_red"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Design review"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:maxLines="1"
                android:fontFamily="@font/ntype82_regular" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="09:30 – 10:30"
                android:textColor="#C8C8C6"
                android:textSize="12sp"
                android:fontFamily="@font/ndot55_regular" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
