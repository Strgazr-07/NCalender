<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="3dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_preview_bar_red"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Design review"
                android:textColor="@color/widget_preview_text"
                android:textSize="14sp"
                android:maxLines="1"
                android:fontFamily="@font/ntype82_regular" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Today · 09:00 – 10:00"
                android:textColor="@color/widget_preview_text_secondary"
                android:textSize="11sp"
                android:fontFamily="@font/ndot55_regular" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/widget_preview_border"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="3dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_preview_bar_dim"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dentist"
                android:textColor="@color/widget_preview_text"
                android:textSize="14sp"
                android:maxLines="1"
                android:fontFamily="@font/ntype82_regular" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tomorrow · 11:00 – 11:30"
                android:textColor="@color/widget_preview_text_secondary"
                android:textSize="11sp"
                android:fontFamily="@font/ndot55_regular" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
