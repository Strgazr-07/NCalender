# Copy this file to keystore.properties (same directory) and fill in your own
# values. keystore.properties is gitignored — never commit real credentials.
#
# To generate a keystore:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias yourAlias

storeFile=release.jks
storePassword=changeme
keyAlias=yourAlias
keyPassword=changeme
